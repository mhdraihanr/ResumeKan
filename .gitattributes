# Skrip shell wajib LF; CRLF membuat shebang gagal di container Linux.
deploy/*.sh   text eol=lf
deploy/*.run  text eol=lf
*.sh          text eol=lf
*.bash        text eol=lf

# Template unit systemd dan Caddyfile juga wajib LF:
# - baris lanjutan ExecStart berakhir "\\\r" sehingga backslash tidak dikenali
#   dan sisa flag -d dicoba dijalankan sebagai executable → unit gagal start.
# - Caddy bisa menolak/menyalahartikan baris Caddyfile yang ber-CRLF.
deploy/systemd/*.tpl  text eol=lf
deploy/Caddyfile      text eol=lf
