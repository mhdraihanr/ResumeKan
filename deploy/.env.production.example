# Salin ke api/.env saat deploy VPS/container baru.
# Nilai yang ditandai ISI_ atau GANTI_ wajib diganti. File ini TIDAK memuat
# secret: isi nilainya langsung di api/.env pada server (mode 0600).
#
# Dua varian pemakaian:
#   * VPS (Debian/Ubuntu + systemd) → deploy/bootstrap.sh menyalin file ini
#     ke api/.env. Gunakan blok "DB field terpisah" di bawah.
#   * Railway (legacy)             → deploy.sh membaca APP_KEY dan DB_URL
#     dari deploy/.env.production. Gunakan blok "DB_URL" di bawah.
#
# Simpan salinan terisi di manajer sandi, JANGAN di-commit.

APP_NAME=ResumeKan
APP_ENV=production
APP_KEY=GANTI_DENGAN_OUTPUT_php_artisan_key_generate_--show
APP_DEBUG=false
APP_URL=https://GANTI_DOMAIN_PUBLIK
FRONTEND_URL=https://GANTI_DOMAIN_PUBLIK

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

# --- DB field terpisah (VPS) -------------------------------------------------
# Dibaca api/config/database.php → connection 'pgsql'. Tidak ada DB_URL di sini,
# jadi tidak ada risiko DB_URL lama mengalahkan field (Laravel memprioritaskan
# `url` bila diisi).
DB_CONNECTION=pgsql
DB_HOST=GANTI_HOST_NEON
DB_PORT=5432
DB_DATABASE=GANTI_NAMA_DATABASE
DB_USERNAME=GANTI_USERNAME_BARU
DB_PASSWORD=GANTI_PASSWORD_BARU
DB_SSLMODE=require

# --- DB_URL (Railway legacy) -------------------------------------------------
# Hanya dipakai kalau deploy/.env.production berisi DB_URL. Deploy VPS tidak
# membaca baris ini. Jangan isi keduanya sekaligus.
# DB_URL=postgresql://ISI_USER:ISI_PASSWORD@ISI_HOST/ISI_DB?sslmode=require

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=GANTI_DOMAIN_PUBLIK_TANPA_HTTPS
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=GANTI_DOMAIN_PUBLIK_TANPA_HTTPS

AI_API_KEY=GANTI_AI_API_KEY
AI_BASE_URL=GANTI_AI_BASE_URL
AI_MODEL=GANTI_NAMA_MODEL
AI_TIMEOUT=30
AI_THROTTLE_PER_MINUTE=5
AI_PARSE_THROTTLE_PER_MINUTE=3

CLOUDINARY_CLOUD_NAME=GANTI_CLOUD_NAME
CLOUDINARY_API_KEY=GANTI_CLOUDINARY_API_KEY
CLOUDINARY_API_SECRET=GANTI_CLOUDINARY_API_SECRET
CLOUDINARY_FOLDER=cvs

CV_MAX_PER_USER=10
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Rate limit register (dipakai config/security.php). Dua lapis per IP:
# per menit menahan burst, per jam menahan akumulasi spam.
REGISTER_PER_MINUTE=5
REGISTER_PER_HOUR=20

# Cloudflare Turnstile — kunci anti-spam register. Site key publik, secret
# rahasia. Wajib diisi di produksi (middleware fail-closed tanpa secret).
TURNSTILE_SITE_KEY=GANTI_TURNSTILE_SITE_KEY
TURNSTILE_SECRET_KEY=GANTI_TURNSTILE_SECRET_KEY
TURNSTILE_TIMEOUT=5

# Dipakai watchdog (dari deploy.sh, bukan Laravel). 2 kalau RAM sangat mepet.
PHP_CLI_SERVER_WORKERS=4
