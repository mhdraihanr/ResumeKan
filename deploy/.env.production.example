# Salin ke api/.env saat deploy container baru.
# Nilai yang ditandai ISI_ wajib diganti. Ini contoh untuk Opsi 1
# (alamat tunggal Railway, mis. resumekan-production.up.railway.app).
#
# deploy.sh membaca APP_KEY dan DB_URL dari file ini. Simpan di luar git
# (nama file ini sudah ada di .gitignore), jangan pernah di-commit.

APP_NAME=ResumeKan
APP_ENV=production
APP_KEY=ISI_HASIL_KEY_GENERATE
APP_DEBUG=false
APP_URL=https://ISI_ALAMAT_RAILWAY
FRONTEND_URL=https://ISI_ALAMAT_RAILWAY

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=warning

DB_CONNECTION=pgsql
DB_URL=ISI_STRING_NEON

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_PATH=/
SESSION_DOMAIN=ISI_ALAMAT_RAILWAY_TANPA_HTTPS
SESSION_SECURE_COOKIE=true
SESSION_SAME_SITE=lax

SANCTUM_STATEFUL_DOMAINS=ISI_ALAMAT_RAILWAY_TANPA_HTTPS

AI_API_KEY=ISI_AI_KEY
AI_BASE_URL=ISI_AI_BASE_URL
AI_MODEL=ISI_NAMA_MODEL
AI_TIMEOUT=30
AI_THROTTLE_PER_MINUTE=5

CLOUDINARY_CLOUD_NAME=ISI_CLOUD_NAME
CLOUDINARY_API_KEY=ISI_API_KEY
CLOUDINARY_API_SECRET=ISI_API_SECRET
CLOUDINARY_FOLDER=cvs

CV_MAX_PER_USER=10
QUEUE_CONNECTION=sync
CACHE_STORE=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log
MAIL_MAILER=log

# Rate limit register (dipakai config/security.php). Dua lapis per IP:
# per menit menahan burst, per jam menahan akumulasi spam.
REGISTER_PER_MINUTE=5
REGISTER_PER_HOUR=20

# Cloudflare Turnstile — kunci anti-spam register. Site key publik, secret
# rahasia. Wajib diisi di produksi (middleware fail-closed tanpa secret).
TURNSTILE_SITE_KEY=ISI_SITE_KEY
TURNSTILE_SECRET_KEY=ISI_SECRET_KEY
TURNSTILE_TIMEOUT=5

# Dipakai watchdog (dari deploy.sh, bukan Laravel). 2 kalau RAM sangat mepet.
PHP_CLI_SERVER_WORKERS=4
