# Satu host: tampilan dan API di origin yang sama.
# Railway mengurus TLS di depan, jadi Caddy cukup HTTP di :8080.
{
	auto_https off
	admin 127.0.0.1:2019
}

:8080 {
	root * /srv/ResumeKan/web/dist
	encode gzip zstd

	handle /api/* {
		# Pembatas body di depan PHP. Backend menerima berkas sampai 5 MB
		# (Impor CV), dan php -S dijalankan dengan post_max_size=8M. Batas di
		# sini sengaja sedikit lebih longgar supaya pesan 413/422 tetap datang
		# dari Laravel (bahasa Indonesia, bisa dibaca pengguna), bukan dari
		# Caddy. Gunanya bukan keramahan pesan, tapi menutup jalur php2shell
		# yang memakai body besar untuk mendorong PHP ke OOM.
		request_body {
			max_size 10MB
		}
		reverse_proxy 127.0.0.1:8000
	}

	handle /sanctum/* {
		# Endpoint ini hanya menerima JSON kecil (login, logout, CSRF cookie).
		request_body {
			max_size 1MB
		}
		reverse_proxy 127.0.0.1:8000
	}

	handle /up {
		reverse_proxy 127.0.0.1:8000
	}

	# Penyangga SPA. Harus di handle{} terakhir: handle bersifat saling eksklusif,
	# jadi letaknya menentukan apakah POST /api/* ikut jatuh ke file statis.
	handle {
		try_files {path} /index.html
		file_server
	}
}
